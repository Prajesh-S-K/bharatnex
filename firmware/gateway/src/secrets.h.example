// Copy this file to secrets.h (untracked -- see .gitignore) and fill in real
// values before building. Never commit real Wi-Fi credentials.
#pragma once

#define WIFI_SSID "your-network-name"
#define WIFI_PASSWORD "your-network-password"

// The laptop running the FastAPI backend, e.g. "http://192.168.1.50:8000"
#define API_BASE_URL "http://192.168.1.50:8000"

// Optional -- must match SMART_MINE_GATEWAY_KEY on the backend if that
// environment variable is set there (apps/api/routes.py). Leave empty if the
// backend has no gateway key configured (the default, prototype-only state).
#define GATEWAY_DEVICE_KEY ""
