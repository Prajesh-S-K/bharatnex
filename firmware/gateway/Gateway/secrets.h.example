// Copy this file to secrets.h (untracked -- see .gitignore) and fill in real
// values before building. Never commit real Wi-Fi credentials.
//
// This is separate from the gateway's own AP credentials (SMART_MINE_GATEWAY /
// mine12345 in Gateway.ino) -- those stay hardcoded exactly as tested, since
// NodeA/NodeB already join that fixed network. These are the REAL room/lab
// Wi-Fi network the gateway joins as a station (STA) so it can reach the
// laptop running the FastAPI backend.
#pragma once

#define STA_WIFI_SSID "your-real-network-name"
#define STA_WIFI_PASSWORD "your-real-network-password"

// The laptop's LAN IP on that same network, e.g. "http://172.16.102.249:8000"
// -- find it with `ipconfig` (Windows) on the laptop, look for the IPv4
// Address under the Wi-Fi adapter actually connected to this same network.
#define API_BASE_URL "http://172.16.102.249:8000"
