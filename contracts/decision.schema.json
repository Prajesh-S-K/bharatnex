{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smart-mine.local/contracts/v1/decision.schema.json",
  "title": "SMART-MINE Decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "node_id", "timestamp", "state", "risk", "confidence", "trend", "reason_codes", "actions"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "node_id": { "type": "string", "enum": ["NODE_A", "NODE_B"] },
    "timestamp": { "type": "string", "format": "date-time" },
    "state": { "type": "string", "enum": ["NORMAL", "WATCH", "WARNING", "CRITICAL"] },
    "risk": { "type": "number", "minimum": 0, "maximum": 100 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 100 },
    "trend": { "type": "string", "enum": ["STABLE", "RISING", "FALLING", "INSUFFICIENT_DATA"] },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["SENSOR_ANOMALY", "DISPLACEMENT_RISING", "TILT_CHANGE", "VIBRATION_SPIKE", "NEIGHBOUR_CORRELATION", "NEAR_ACTIVE_FACE", "PERSISTENT_EVENT", "LOW_SENSOR_HEALTH", "MISSING_DATA"]
      },
      "uniqueItems": true
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["BASELINE_LOGGING", "INCREASE_MONITORING", "HIGH_RATE_MONITORING", "CREATE_INCIDENT", "SAFETY_RECOMMENDATION", "ACTIVATE_BUZZER", "DISPATCH_INSPECTION"]
      },
      "uniqueItems": true
    }
  }
}

